# ── Gemini ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MongoDB ────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/store_intelligence

# ── CV Service ─────────────────────────────────────
VIDEO_SOURCE=./videos/sample.mp4   # or rtsp://... for live stream
YOLO_MODEL=yolov8n.pt              # yolov8m.pt for better accuracy
CROWD_THRESHOLD=10                 # people count to trigger crowd alert
ABNORMAL_CHECK_INTERVAL=5          # seconds between Gemini checks
GENDER_CACHE_TTL=30                # seconds to cache gender per track ID
FRAME_SKIP=2                       # process every Nth frame (speed tuning)

# ── API Service ────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Dashboard ──────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000